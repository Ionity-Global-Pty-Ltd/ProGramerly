/* ProGramerly Command Center -------------------------------------------------
   A kiosk-friendly home surface built from live local data. */

#homeView{
  overflow-y:auto;
  padding:18px 22px 26px;
  gap:14px;
}

.home-hero{
  position:relative;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:28px;
  align-items:center;
  min-height:208px;
  padding:26px 28px;
  overflow:visible;
  border:1px solid rgba(0,198,255,.24);
  border-radius:18px;
  background:
    linear-gradient(110deg,rgba(8,17,29,.96) 0%,rgba(13,31,49,.9) 52%,rgba(0,198,255,.1) 100%);
  box-shadow:0 20px 60px -38px rgba(0,198,255,.75),inset 0 1px rgba(255,255,255,.04);
}
.home-hero::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  border-radius:inherit;
  background:
    linear-gradient(90deg,transparent 0 72%,rgba(0,198,255,.07) 72% 72.4%,transparent 72.4%),
    repeating-linear-gradient(90deg,transparent 0 55px,rgba(255,255,255,.018) 56px);
  mask-image:linear-gradient(90deg,transparent,black 58%);
}
.home-hero-copy,.home-clock-panel{position:relative;z-index:1}
.home-eyebrow{
  margin:0 0 7px;
  color:var(--cyan);
  font-family:var(--mono);
  font-size:10.5px;
  font-weight:650;
  letter-spacing:2.2px;
  text-transform:uppercase;
}
.home-hero h2{margin:0;font-size:clamp(27px,3vw,43px);font-weight:680;letter-spacing:-1.2px}
.home-machine-line{margin:8px 0 18px;color:var(--text-dim);font-size:12.5px;line-height:1.5}

.home-command-wrap{position:relative;width:min(720px,100%)}
.home-command{
  display:grid;
  grid-template-columns:auto minmax(0,1fr) auto;
  align-items:center;
  min-height:51px;
  padding:0 7px 0 16px;
  border:1px solid rgba(0,198,255,.3);
  border-radius:13px;
  background:rgba(2,8,14,.72);
  box-shadow:0 12px 32px -24px #000;
}
.home-command:focus-within{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(0,198,255,.1),0 16px 36px -24px #000}
.home-command-icon{margin-right:11px;color:var(--cyan);font-size:19px}
.home-command input{
  min-width:0;
  border:0;
  outline:0;
  background:transparent;
  color:var(--text);
  font:13.5px var(--font);
}
.home-command input::placeholder{color:var(--text-faint)}
.home-command kbd,.command-result kbd{
  border:1px solid var(--line-soft);
  border-radius:6px;
  background:rgba(255,255,255,.04);
  color:var(--text-faint);
  font:10px var(--mono);
  padding:3px 6px;
}
.home-command button{padding:7px 12px}
.home-command-results{
  position:absolute;
  z-index:20;
  top:calc(100% + 7px);
  left:0;
  right:0;
  max-height:360px;
  overflow-y:auto;
  padding:7px;
  border:1px solid rgba(0,198,255,.25);
  border-radius:13px;
  background:rgba(7,14,24,.98);
  box-shadow:0 24px 60px -24px #000;
  backdrop-filter:blur(18px);
}
.command-result{
  width:100%;
  display:grid;
  grid-template-columns:42px 1fr auto;
  gap:10px;
  align-items:center;
  padding:9px 10px;
  border:0;
  border-radius:9px;
  background:transparent;
  color:var(--text);
  font:inherit;
  text-align:left;
  cursor:pointer;
}
.command-result:hover,.command-result:focus{outline:0;background:rgba(0,198,255,.1)}
.command-result:disabled{opacity:.4;cursor:not-allowed}
.command-result b{display:block;font-size:12.5px}
.command-result small{display:block;margin-top:2px;color:var(--text-faint);font-size:10.5px}
.command-glyph{
  display:grid;
  place-items:center;
  width:34px;
  height:34px;
  border:1px solid var(--line);
  border-radius:9px;
  background:rgba(0,198,255,.07);
  color:var(--cyan);
  font:600 11px var(--mono);
}

.home-clock-panel{min-width:260px;text-align:right}
.home-clock{font:300 clamp(42px,5vw,66px)/1 var(--mono);letter-spacing:-3px;color:#fff;text-shadow:0 0 28px rgba(0,198,255,.25)}
.home-date{margin-top:7px;color:var(--text-dim);font-size:12px}
.home-health{
  display:inline-flex;
  align-items:center;
  gap:8px;
  margin-top:19px;
  padding:7px 11px;
  border:1px solid rgba(51,214,159,.25);
  border-radius:99px;
  background:rgba(51,214,159,.06);
  color:var(--ok);
  font-size:11.5px;
}
.home-health::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 9px currentColor}
.home-health.warn{color:var(--warn);border-color:rgba(255,179,64,.3);background:rgba(255,179,64,.06)}
.home-health.err{color:var(--err);border-color:rgba(255,93,108,.3);background:rgba(255,93,108,.06)}
.home-metrics-at{margin-top:7px;color:var(--text-faint);font:10px var(--mono)}

.home-metrics{
  display:grid;
  grid-template-columns:repeat(5,minmax(150px,1fr));
  gap:10px;
}
.dash-metric{
  position:relative;
  min-height:126px;
  padding:14px 15px;
  overflow:hidden;
  border:1px solid var(--line-soft);
  border-radius:13px;
  background:linear-gradient(155deg,rgba(23,39,60,.68),rgba(8,16,27,.72));
}
.dash-metric::after{content:"";position:absolute;right:-22px;bottom:-30px;width:90px;height:90px;border-radius:50%;background:rgba(0,198,255,.055);filter:blur(1px)}
.dash-metric.warn{border-color:rgba(255,179,64,.35)}
.dash-metric.warn::after{background:rgba(255,179,64,.09)}
.dash-metric.err{border-color:rgba(255,93,108,.4)}
.dash-metric.err::after{background:rgba(255,93,108,.1)}
.metric-head{display:flex;align-items:center;justify-content:space-between;color:var(--text-faint);font-size:10px;letter-spacing:1px;text-transform:uppercase}
.metric-head span:last-child{font-size:14px;color:var(--cyan)}
.metric-value{position:relative;z-index:1;margin-top:10px;font:600 23px var(--mono);font-variant-numeric:tabular-nums}
.metric-note{position:relative;z-index:1;margin-top:4px;overflow:hidden;color:var(--text-dim);font-size:10.5px;text-overflow:ellipsis;white-space:nowrap}
.metric-track{position:absolute;z-index:1;left:15px;right:15px;bottom:13px;height:4px;overflow:hidden;border-radius:99px;background:rgba(255,255,255,.07)}
.metric-track i{display:block;width:0;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--cyan-dim),var(--cyan));transition:width .45s ease}
.dash-metric.warn .metric-track i{background:var(--warn)}
.dash-metric.err .metric-track i{background:var(--err)}
.net-pulse{position:absolute;right:16px;bottom:15px;display:flex;gap:3px;align-items:end;height:19px}
.net-pulse i{display:block;width:3px;border-radius:3px;background:var(--cyan);animation:netPulse 1.4s ease-in-out infinite}
.net-pulse i:nth-child(1){height:7px}.net-pulse i:nth-child(2){height:14px;animation-delay:.15s}.net-pulse i:nth-child(3){height:10px;animation-delay:.3s}.net-pulse i:nth-child(4){height:18px;animation-delay:.45s}
@keyframes netPulse{50%{opacity:.25;transform:scaleY(.45)}}

.home-cockpit{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}
.home-panel{margin:0!important;padding:17px 18px}
.home-program-panel{grid-column:span 8}
.home-ai-panel{grid-column:span 4;background:linear-gradient(150deg,rgba(26,24,64,.65),rgba(9,18,31,.68))}
.home-spaces-panel{grid-column:span 7}
.home-ops-panel{grid-column:span 5}

.program-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.program-tile{
  display:grid;
  grid-template-columns:47px minmax(0,1fr) auto;
  gap:11px;
  align-items:center;
  min-height:116px;
  padding:12px;
  border:1px solid var(--line-soft);
  border-radius:12px;
  background:rgba(4,10,18,.32);
  transition:transform .16s,border-color .16s,background .16s;
}
.program-tile:hover{transform:translateY(-2px);border-color:rgba(0,198,255,.35);background:rgba(0,198,255,.035)}
.program-tile.bad{border-color:rgba(255,93,108,.35)}
.program-tile.missing{opacity:.48}
.program-glyph{display:grid;place-items:center;width:47px;height:47px;border:1px solid rgba(0,198,255,.3);border-radius:13px;background:linear-gradient(145deg,rgba(0,198,255,.17),rgba(0,198,255,.035));color:var(--cyan);font:700 11px var(--mono);letter-spacing:-.4px}
.program-copy{min-width:0}
.program-title{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.program-title h4{margin:0;font-size:13px}
.program-state{padding:2px 6px;border-radius:5px;background:rgba(0,198,255,.09);color:var(--cyan);font:9px var(--mono);text-transform:uppercase}
.program-tile.ok .program-state{background:rgba(51,214,159,.1);color:var(--ok)}
.program-tile.bad .program-state{background:rgba(255,93,108,.1);color:var(--err)}
.program-copy p{margin:5px 0;color:var(--text-dim);font-size:10.8px;line-height:1.4}
.program-meta{display:flex;gap:8px;flex-wrap:wrap;color:var(--text-faint);font:9.5px var(--mono)}
.program-launch{padding:7px 11px;white-space:nowrap}
.home-panel-note{margin:10px 0 0;color:var(--text-faint);font-size:10.5px;line-height:1.5}

.ai-state{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:start;margin:2px 0 13px;padding:10px 11px;border:1px solid var(--line-soft);border-radius:10px;background:rgba(0,0,0,.18)}
.ai-orb{width:9px;height:9px;margin-top:4px;border-radius:50%;background:var(--skip);box-shadow:0 0 0 4px rgba(107,127,150,.08)}
.ai-orb.online{background:var(--ok);box-shadow:0 0 12px rgba(51,214,159,.75)}
.ai-state b{display:block;font-size:12px}.ai-state small{display:block;margin-top:3px;color:var(--text-faint);font-size:10.5px;line-height:1.4}
.home-ai-panel textarea{width:100%;min-height:82px;resize:vertical;padding:10px 11px;border:1px solid var(--line-soft);border-radius:10px;outline:0;background:rgba(0,0,0,.23);color:var(--text);font:12.5px/1.45 var(--font)}
.home-ai-panel textarea:focus{border-color:var(--cyan-dim);box-shadow:0 0 0 3px rgba(0,198,255,.1)}
.ai-seeds{display:flex;gap:6px;flex-wrap:wrap;margin:9px 0}
.ai-seed{padding:5px 8px;border:1px solid var(--line-soft);border-radius:99px;background:transparent;color:var(--text-dim);font:10.5px var(--font);cursor:pointer}
.ai-seed:hover{border-color:var(--line);color:var(--cyan)}
.ai-action-row{display:flex;align-items:center;gap:8px}.ai-action-row small{margin-right:auto;color:var(--text-faint);font-size:9.5px}

.space-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.space-tile{display:flex;flex-direction:column;gap:6px;min-height:92px;padding:11px;border:1px solid var(--line-soft);border-radius:11px;background:rgba(4,10,18,.26);color:var(--text);font:inherit;text-align:left;cursor:pointer;transition:.15s}
.space-tile:hover{border-color:rgba(0,198,255,.4);background:rgba(0,198,255,.055);transform:translateY(-2px)}
.space-glyph{color:var(--cyan);font:650 15px var(--mono)}
.space-tile b{font-size:11.5px}.space-tile small{color:var(--text-faint);font-size:9.8px;line-height:1.35}

.ops-list{display:flex;flex-direction:column;gap:7px}
.ops-row{display:grid;grid-template-columns:35px minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 10px;border:1px solid var(--line-soft);border-radius:10px;background:rgba(4,10,18,.25)}
.ops-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:rgba(0,198,255,.08);color:var(--cyan);font:600 12px var(--mono)}
.ops-copy b{display:block;font-size:11.5px}.ops-copy small{display:block;margin-top:2px;color:var(--text-faint);font-size:9.8px;line-height:1.35}
.ops-row .btn{padding:6px 9px;font-size:10.5px}

#homeLiveBadge.live{color:var(--ok);border-color:rgba(51,214,159,.35);background:rgba(51,214,159,.07)}
#kioskExitBtn{color:#fff;border-color:rgba(255,93,108,.5);background:rgba(255,93,108,.16)}
.home-empty{grid-column:1/-1;margin:8px;color:var(--text-faint);font-size:11.5px}
.kiosk-shell .topbar{padding-top:10px;padding-bottom:10px}
.kiosk-shell .bottombar{padding-top:9px;padding-bottom:9px}
.kiosk-shell #homeView{padding-bottom:20px}

@media (max-width:1260px){
  .home-metrics{grid-template-columns:repeat(3,1fr)}
  .home-program-panel,.home-ai-panel,.home-spaces-panel,.home-ops-panel{grid-column:1/-1}
  .home-ai-panel{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}
  .home-ai-panel .cardhead{grid-column:1/-1}.home-ai-panel .ai-state{grid-row:2/5}.home-ai-panel textarea{grid-column:2}.home-ai-panel .ai-seeds,.home-ai-panel .ai-action-row{grid-column:2}
}
@media (max-width:900px){
  #homeView{padding:12px 14px 20px}
  .home-hero{grid-template-columns:1fr;gap:18px;padding:21px;min-height:0}
  .home-clock-panel{text-align:left;min-width:0}.home-clock{font-size:42px}.home-health{margin-top:12px}
  .home-metrics{grid-template-columns:repeat(2,1fr)}
  .program-grid{grid-template-columns:1fr}
  .space-grid{grid-template-columns:repeat(2,1fr)}
  .home-ai-panel{display:block}
}
@media (prefers-reduced-motion:reduce){
  .net-pulse i{animation:none}.program-tile,.space-tile{transition:none}
}
